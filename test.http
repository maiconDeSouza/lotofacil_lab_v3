@base_url = http://127.0.0.1:1977

### 1. Rota Teste
GET {{base_url}} 


### 2. Create Game Fixed
POST  {{base_url}}/fixed 
Content-Type: application/json

{
    "number": 3832
}


### 3. UPDATE Game Fixed
PUT   {{base_url}}/fixed/3832 
Content-Type: application/json

{
    "correct": 11,
    "correctNumbers": [1, 2, 9, 10, 15, 19, 20, 22, 24, 25]
}

### 4. GET Game Fixed
GET   {{base_url}}/fixed/3832


### 5. GET ALL Game Fixed
GET   {{base_url}}/fixed/all


### 6. Create Game Frequency
POST  {{base_url}}/frequency 
Content-Type: application/json

{
    "number": 3832
}


### 7. UPDATE Game Fixed
PUT   {{base_url}}/frequency/3832 
Content-Type: application/json

{
    "correct": 10,
    "correctNumbers": [1, 2, 9, 10, 15, 19, 20, 22, 24, 25]
}


